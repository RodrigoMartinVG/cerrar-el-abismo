{
  "name": "cerrar-el-abismo",
  "private": true,
  "type": "module",
  "description": "Matemática y práctica: una obra de matemática de licenciatura en trece tomos, pensada para la web, que cierra el abismo entre la matemática que se estudia y la que se usa.",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w site",
    "preview": "npm run preview -w site",
    "check": "tsc -p packages/indice && tsc -p packages/libro && tsc -p packages/piezas && npm run check -w site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "indice:spec": "node packages/indice/scripts/escribir-especificacion.ts",
    "verify": "npm run check && npm run lint && npm run format:check && npm run ortografia && npm test",
    "e2e": "playwright test",
    "ortografia": "cspell --no-progress --show-suggestions"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "^3.0.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "pyodide": "^314.0.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
