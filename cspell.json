{
  "version": "0.2",
  "language": "es,en",
  "import": ["@cspell/dict-es-es/cspell-ext.json"],
  "dictionaryDefinitions": [
    {
      "name": "obra",
      "path": "./ortografia/palabras.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["obra"],
  "files": [
    "docs/**/*.md",
    "indice/**/*.yaml",
    "site/src/**/*.{md,mdx}",
    "README.md",
    "CLAUDE.md",
    "revision/README.md",
    "roadmap.md"
  ],
  "ignorePaths": ["docs/historico/**", "node_modules/**", "**/dist/**"],
  "ignoreRegExpList": [
    "var\\(--[\\w-]+\\)",
    "```[\\s\\S]*?```",
    "`[^`\\n]*`",
    "\\$\\$[\\s\\S]*?\\$\\$",
    "\\$[^$\\n]*\\$",
    "\\{[#.][^}]*\\}",
    "\\{(?:[^{}\\n]|\\{[^{}\\n]*\\})*=(?:[^{}\\n]|\\{[^{}\\n]*\\})*\\}",
    "https?://\\S+",
    "^\\s*(?:- )?[a-z_]+:(?=\\s|$)",
    "\\b(?:campo|tipo|id|capitulo|estado|pieza|ancla):\\s*[\\w.-]+",
    "\\bcampos:\\s*\\[[^\\]]*\\]",
    "\\banclas:\\s*\\[[^\\]]*\\]",
    ":{2,3}[a-z-]+",
    ":ref\\[[^\\]]*\\]",
    "[\\w./-]+\\.(?:md|ts|mjs|json|yaml|astro)\\b",
    "e\\^\\([^)]*\\)",
    "^\\s*claves:.*$"
  ]
}
