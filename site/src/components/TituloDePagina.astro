---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { Badge } from '@astrojs/starlight/components';
import { slug, todosLosCapitulos, tomoDe } from '@cerrar-el-abismo/indice';
import { obra, urlCapitulo, urlEnIndice, urlMapa, urlReportarError, urlRevision, urlTomo } from '../lib/obra';
import { avanceDe, NOMBRES_DE_ESTADOS } from '../lib/revision';

/**
 * Bajo el título de un capítulo escrito, sus metadatos del índice (tipo, extensión, requisitos), su estado y cuántos de
 * sus resultados están revisados (decisión 0005).
 */
const { data, body } = Astro.locals.starlightRoute.entry;
const datos = data as { capitulo?: string; estado?: string };
const c = datos.capitulo ? todosLosCapitulos(obra()).find((x) => x.id === datos.capitulo) : undefined;
const tomo = c ? obra().tomos.find((t) => t.id === tomoDe(c.id)) : undefined;
const revision = c ? avanceDe(c.id, body ?? '') : undefined;
const reportar = c ? urlReportarError(c.id, `${c.id} ${c.titulo}`, new URL(Astro.url.pathname, Astro.site).href) : undefined;
/** En una página de sección (decisión 0008), el antetítulo es el capítulo, con un enlace a su portada. */
const deSeccion = /\/capitulos\/([^/]+)\/[^/]+\/$/.exec(Astro.url.pathname)?.[1];
const capituloDeSeccion = deSeccion ? todosLosCapitulos(obra()).find((x) => slug(x.id) === deSeccion) : undefined;
---

{
  capituloDeSeccion && (
    <p class="capitulo-antetitulo">
      <a href={urlCapitulo(capituloDeSeccion.id)}>
        {capituloDeSeccion.id} {capituloDeSeccion.titulo}
      </a>
    </p>
  )
}

{
  tomo && (
    <p class="capitulo-antetitulo">
      <a href={urlTomo(tomo.id)}>
        Tomo {tomo.id} · {tomo.titulo}
      </a>
    </p>
  )
}
<Default />
{
  c && (
    <p class="capitulo-meta">
      <Badge text={c.tipo === 'nucleo' ? 'Núcleo' : 'Complementario'} variant={c.tipo === 'nucleo' ? 'success' : 'default'} />
      {datos.estado && <Badge text={NOMBRES_DE_ESTADOS[datos.estado] ?? datos.estado} variant="caution" />}
      <span>
        {c.paginas} págs. estimadas · Requiere:{' '}
        {c.requiere.length === 0
          ? '—'
          : c.requiere.map((r, i) => (
              <>
                {i > 0 && ', '}
                <a href={urlCapitulo(r)}>{r}</a>
              </>
            ))}{' '}
        · <a href={urlEnIndice(c.id)}>Su entrada en el índice</a> · <a href={urlMapa(c.id)}>Su recorrido</a>
        {revision && (
          <>
            {' '}
            ·{' '}
            <a href={urlRevision(c.id)} class="capitulo-revision">
              Revisión: {revision.primera} de {revision.resultados} resultados
              {revision.segunda > 0 && `, ${revision.segunda} con la segunda pasada`}
            </a>
          </>
        )}
        {reportar && (
          <>
            {' '}
            ·{' '}
            <a href={reportar} class="reportar-error" rel="noopener" target="_blank">
              Reportar un error
            </a>
          </>
        )}
      </span>
    </p>
  )
}

<script>
  // Al reportar un error, la dirección lleva el ancla en la que está el lector, si llegó a una (#teo-lagrange).
  for (const enlace of document.querySelectorAll<HTMLAnchorElement>('a.reportar-error')) {
    enlace.addEventListener('click', () => {
      if (!location.hash) return;
      const url = new URL(enlace.href);
      const cuerpo = url.searchParams.get('body') ?? '';
      url.searchParams.set('body', cuerpo.replace(/^(\*\*Dirección:\*\* )\S+$/m, `$1${location.href}`));
      enlace.href = url.toString();
    });
  }
</script>
