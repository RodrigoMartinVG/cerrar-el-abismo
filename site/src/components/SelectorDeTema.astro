---
import Default from '@astrojs/starlight/components/ThemeSelect.astro';

/**
 * Junto al selector de tema, dos botones para leer sin distracciones: ocultan el índice de la obra (el panel de la
 * izquierda) y el índice de la página (el de la derecha). La preferencia se guarda en el navegador, y un guion en el
 * `head` (astro.config.mjs) la aplica antes de dibujar, para que los paneles no aparezcan y desaparezcan.
 */
---

<div class="paneles">
  <button type="button" class="panel panel-indice" data-panel="indice" aria-pressed="false" aria-label="Ocultar el índice de la obra">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="4.5" width="18" height="15" rx="2"></rect>
      <path d="M9 4.5v15"></path>
    </svg>
  </button>
  <button type="button" class="panel panel-toc" data-panel="toc" aria-pressed="false" aria-label="Ocultar el índice de la página">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="3" y="4.5" width="18" height="15" rx="2"></rect>
      <path d="M15 4.5v15"></path>
    </svg>
  </button>
</div>
<Default />

<script>
  const PANELES = {
    indice: { atributo: 'data-sin-indice', clave: 'obra:sin-indice' },
    toc: { atributo: 'data-sin-toc', clave: 'obra:sin-toc' },
  } as const;
  type Panel = keyof typeof PANELES;

  const raiz = document.documentElement;
  // Starlight dibuja el selector de tema dos veces (en la cabecera y en el menú del móvil): todos los botones de un
  // mismo panel se pintan juntos.
  const botones = [...document.querySelectorAll<HTMLButtonElement>('button[data-panel]')];
  const pintar = () => {
    for (const boton of botones) {
      const oculto = raiz.hasAttribute(PANELES[boton.dataset['panel'] as Panel].atributo);
      const etiqueta = boton.getAttribute('aria-label')!;
      boton.setAttribute('aria-pressed', String(oculto));
      boton.title = oculto ? etiqueta.replace('Ocultar', 'Mostrar') : etiqueta;
    }
  };
  for (const boton of botones) {
    const { atributo, clave } = PANELES[boton.dataset['panel'] as Panel];
    boton.addEventListener('click', () => {
      const oculto = raiz.toggleAttribute(atributo);
      try {
        localStorage.setItem(clave, oculto ? '1' : '0');
      } catch {
        // Sin almacenamiento (ventana privada, sitio bloqueado): el panel se oculta igual, solo que no se recuerda.
      }
      pintar();
    });
  }
  pintar();
</script>

<style>
  .paneles {
    display: flex;
    gap: 0.25rem;
  }

  .panel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .panel:hover,
  .panel:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-5);
  }

  .panel[aria-pressed='true'] {
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* Cada botón aparece solo donde su panel es fijo: el índice de la obra desde 50em, el de la página desde 72em. En el
     móvil, los dos son menús que ya se abren y se cierran. */
  .panel-indice,
  .panel-toc {
    display: none;
  }

  @media (min-width: 50em) {
    :global(:root[data-has-sidebar]) .panel-indice {
      display: inline-flex;
    }
  }

  @media (min-width: 72em) {
    :global(:root[data-has-toc]) .panel-toc {
      display: inline-flex;
    }
  }
</style>
